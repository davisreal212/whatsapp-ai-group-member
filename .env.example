NODE_ENV=development
PORT=3000
DATA_DIR=./data
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
DATABASE_URL=
ADMIN_TOKEN=
BOT_NAME=Kola
BOT_JID=
GROUP_ONLY_MODE=false
DIRECT_MESSAGE_ALLOWLIST=
DRY_RUN=true
OUTBOUND_PAUSED=false
AI_PROCESSING_PAUSED=false
GROUP_COOLDOWN_MS=15000
DIRECT_REPLY_BYPASS=true
DIRECT_MENTION_BYPASS=true
DIRECT_REPLY_DELAY_MIN_MS=250
DIRECT_REPLY_DELAY_MAX_MS=1000
DIRECT_MENTION_DELAY_MIN_MS=250
DIRECT_MENTION_DELAY_MAX_MS=1000
ADAPTIVE_ACTIVITY=true
GROUP_MENTION_ALL_COOLDOWN_MS=1800000
DAILY_ACTION_LIMIT=50
ACTIONS_PER_MINUTE=10
ACTIONS_PER_HOUR=50
ACTION_MAX_ATTEMPTS=3
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=22
QUIET_HOURS_END=7
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
AUDIO_REPLY_MODE=adaptive
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_AGENT_ID=
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=
ELEVENLABS_WHATSAPP_CALL_PERMISSION_TEMPLATE_NAME=
ELEVENLABS_WHATSAPP_CALL_PERMISSION_TEMPLATE_LANGUAGE_CODE=
CMC_API_KEY=
MAX_MEDIA_BYTES=10485760
MAX_VIDEO_DURATION_SECONDS=300
MEDIA_DOWNLOADS_PER_HOUR=100
MESSAGE_RETENTION_DAYS=30
MEMORY_RECENT_MESSAGE_LIMIT=20
MEMORY_GROUP_LIMIT=10
MEMORY_MEMBER_LIMIT=5
MEMORY_SEMANTIC_LIMIT=5
MEMORY_STALE_AFTER_DAYS=30
MEMORY_ARCHIVE_AFTER_DAYS=90

# Optional AI providers. Leave blank to run safely in dry-run/local-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
PHOENIX_API_KEY=
PHOENIX_API_BASE_URL=https://concerned-swordfish-suhailtechlnfo-01fd2de0.koyeb.app
PHOENIX_PRIMARY_MODEL=gpt-6-astra
PHOENIX_SECONDARY_MODEL=gpt-5.6-sol
AI_REQUEST_TIMEOUT_MS=12000
AI_OPERATION_TIMEOUT_MS=20000
QDRANT_URL=
QDRANT_API_KEY=
# Qdrant Cloud Inference handles embedding requests without Gemini quota usage.
QDRANT_COLLECTION=memories-e5-small
EMBEDDING_PROVIDER=qdrant
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# Optional current-information backup search.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MS=60000
