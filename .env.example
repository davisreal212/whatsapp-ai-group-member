NODE_ENV=development
PORT=3000
DATA_DIR=./data
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
DATABASE_URL=
ADMIN_TOKEN=
BOT_NAME=Kola
BOT_JID=
GROUP_ONLY_MODE=true
DIRECT_MESSAGE_ALLOWLIST=
DRY_RUN=true
OUTBOUND_PAUSED=false
AI_PROCESSING_PAUSED=false
GROUP_COOLDOWN_MS=30000
DAILY_ACTION_LIMIT=50
MESSAGE_RETENTION_DAYS=30

# Optional AI providers. Leave blank to run safely in dry-run/local-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional current-information backup search.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
