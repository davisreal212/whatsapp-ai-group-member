NODE_ENV=production
PORT=3000
DATA_DIR=/var/lib/whatsapp-ai/data
WHATSAPP_AUTH_DIR=/var/lib/whatsapp-ai/whatsapp-auth
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
ADMIN_TOKEN=replace-with-a-long-random-secret
BOT_NAME=Kola
BOT_JID=
GROUP_ONLY_MODE=false
DIRECT_MESSAGE_ALLOWLIST=

# Safe production baseline. Set DRY_RUN=false and OUTBOUND_PAUSED=false only
# after pairing and controlled test-group verification.
DRY_RUN=true
OUTBOUND_PAUSED=true
AI_PROCESSING_PAUSED=false
GROUP_COOLDOWN_MS=15000
DIRECT_REPLY_BYPASS=true
DIRECT_MENTION_BYPASS=true
DIRECT_REPLY_DELAY_MIN_MS=1000
DIRECT_REPLY_DELAY_MAX_MS=3000
DIRECT_MENTION_DELAY_MIN_MS=1000
DIRECT_MENTION_DELAY_MAX_MS=3000
ADAPTIVE_ACTIVITY=true
GROUP_MENTION_ALL_COOLDOWN_MS=1800000
DAILY_ACTION_LIMIT=50
ACTIONS_PER_MINUTE=10
ACTIONS_PER_HOUR=50
ACTION_MAX_ATTEMPTS=3
QUIET_HOURS_START=-1
QUIET_HOURS_END=-1
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
AUDIO_REPLY_MODE=adaptive
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
CMC_API_KEY=
MAX_MEDIA_BYTES=10485760
MAX_VIDEO_DURATION_SECONDS=300
MEDIA_DOWNLOADS_PER_HOUR=100
MESSAGE_RETENTION_DAYS=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
PHOENIX_API_KEY=
PHOENIX_API_BASE_URL=https://fastapi-ai-koyeb-app-production.up.railway.app
PHOENIX_PRIMARY_MODEL=deepseek-v4-flash
PHOENIX_SECONDARY_MODEL=glm-5.3
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=memories
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MS=60000
